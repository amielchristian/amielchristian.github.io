---
import SocialsBar from '../components/global/SocialsBar';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section
    class='h-[100vh] flex flex-col justify-center mx-[10%] md:mx-[15%] lg:mx-[20%] text-center mb-[5%]'
  >
    <div
      class='font-[Junicode] leading-none text-[calc(100%+15vw)] sm:text-[calc(100%+11.5vw)] md:text-[calc(100%+8vw)] font-bold'
    >
      <div>
        hello, my name is <span class='italic text-[var(--theme-1)]'>Amiel</span
        >.
      </div>
    </div>
    <div class='sm:mt-6 mb-4 mx-[10%] lg:mx-[15%]'>
      I'm a software developer and machine learning practitioner based in
      Manila. Welcome to my little corner of the internet!
    </div>
    <div class='sm:mt-6 mb-4 mx-[10%] lg:mx-[15%]'>
      Learn more about me <a href='/about'>here</a>.
    </div>
    <SocialsBar client:only='react' />
  </section>
  <section class='mx-[5%] md:mx-[7.5%] mb-[5%]'>
    <div
      class='font-[BricolageGrotesque] text-6xl font-bold text-center sm:text-left'
    >
      Tech Stack
    </div>
    <div class='mt-6 grid xl:grid-cols-[1fr_2fr] grid-rows-auto gap-4 lg:gap-8'>
      <div
        class='flex flex-col gap-2 mb-6 mt-4 text-justify lg:items-center lg:ml-4'
      >
        <div>
          My skills and interest computer science span a variety of fields of
          computer science, including web development, machine learning, and
          compiler design. These are some of the technologies I am most
          experienced in and enjoy using the most.
        </div>
        <div>
          Learn more about me and my experience with all sorts of technologies <a
            href='/about'>here</a
          >.
        </div>
        <!-- <div>
          (I want the border to be colored, with the color moving when the div
          is moused over.)
        </div> -->
      </div>
      <div
        class='border-4 rounded-xl p-8 grid grid-rows-auto grid-cols-3 sm:grid-cols-5 gap-5'
      >
        <i class='aspect-1 rounded-lg overflow-hidden bg-[#007acc] p-2'>
          <img
            class='object-fill'
            src='https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg'
          /></i
        >
        <i class='aspect-1 rounded-lg overflow-hidden bg-[#f0db4f] p-2'>
          <img
            class='object-fill'
            src='https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg'
          />
        </i>
        <i
          class='aspect-1 rounded-lg overflow-hidden bg-[var(--skill-light)] dark:bg-[var(--light)] p-2'
        >
          <img
            class='object-fill'
            src='https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-original.svg'
          />
        </i>
        <i
          class='aspect-1 rounded-lg overflow-hidden bg-[var(--skill-light)] dark:bg-[var(--light)] p-2'
        >
          <img
            class='object-fill'
            src='https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg'
          />
        </i>
        <i
          class='aspect-1 rounded-lg overflow-hidden bg-[var(--skill-light)] dark:bg-[var(--light)] p-2'
        >
          <img
            class='object-fill'
            src='https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg'
          />
        </i>
        <i
