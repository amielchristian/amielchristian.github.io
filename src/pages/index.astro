---
import SocialsBar from '../components/global/SocialsBar';
import SkillPanel from '../components/global/SkillPanel.svelte';
import ProjectCard from '../components/global/ProjectCard.svelte';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const featured = await getCollection('works', ({ data }) => {
  return data.featured;
});
---

<Layout>
  <header
    class='lg:mx-[5%] h-[calc(100vh-var(--spacing)*20)] xl:h-200 flex flex-col justify-center text-center mb-[5%]'
  >
    <div
      class='font-[Junicode] leading-none text-[calc(100%+15vw)] sm:text-[calc(100%+11.5vw)] md:text-[calc(100%+8vw)] xl:text-9xl font-bold'
    >
      <div>
        hello, my name is <span class='italic text-[var(--blue-1)]'>Amiel</span
        >.
      </div>
    </div>
    <div class='sm:mt-6 mb-4 mx-[10%] lg:mx-[15%]'>
      I'm a software developer and machine learning practitioner based in
      Manila. Welcome to my little corner of the internet!
    </div>
    <div class='sm:mt-6 mb-4 mx-[10%] lg:mx-[15%]'>
      Learn more about me <a
        class='text-[var(--blue-2)] dark:text-[var(--blue-2-dark)] underline'
        href='/about'>here</a
      >.
    </div>
    <SocialsBar client:only='react' />
  </header>
  <section class='mb-[5%]'>
    <div class='font-[BricolageGrotesque] text-6xl font-bold'>Tech Stack</div>
    <div class='mt-6 mx-2 flex flex-col xl:flex-row justify-between'>
      <div
        class='xl:w-[37.5%] flex flex-col gap-2 mb-6 mt-4 text-justify lg:ml-4'
      >
        <div>
          My skills and interest computer science span a variety of fields of
          computer science, including web development, machine learning, and
          compiler design. These are some of the technologies I am most
          experienced in and enjoy using the most.
        </div>
        <div>
          Learn more about me and my experience with all sorts of technologies <a
            class='text-[var(--blue-2)] dark:text-[var(--blue-2-dark)] underline'
            href='/about'>here</a
          >.
        </div>
      </div>
      <SkillPanel client:only='svelte' />
    </div>
  </section>
  <section class='mb-[5%]'>
    <div class='font-[BricolageGrotesque] text-6xl font-bold text-center'>
      Featured Works
    </div>
    <div class='mt-6 grid grid-cols-1 lg:grid-cols-2 gap-3'>
      {
        featured.map((work) => (
          <ProjectCard
            client:only='svelte'
            title={work.data.title}
            url={`/works/${work.id}`}
            image={work.data.main_image}
            description={work.data.description}
          />
        ))
      }
    </div>
  </section>

  <!-- <div>welcome to Amiel's website!</div>
  <div>a few icon links...</div>
  <div>abridged about me section...</div>
  <div>my tech stack...</div>
  how to organize? general purpose: TypeScript, JS, Java, Kotlin, Python, PHP, Rust,
  MySQL, PSQL, SQLite web: Astro, Next, Express, Fastify, Flask, Laravel, Django,
  SvelteKit, WebAssembly, Electron, React, Svelte, Tailwind, SCSS data science: jupyter
  notebook, tensorflow, keras, scipy, sklearn, transformers library cloud: GCP, DigitalOcean,
  AWS, Netlify, Vercel other: Ubuntu, LaTeX or a toggle for favorites/notables? -->
</Layout>
