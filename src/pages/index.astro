        >
          <img
            class='object-fill'
            src='https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/django/django-plain.svg'
          />
        </i>
        <i
          class='aspect-1 rounded-lg overflow-hidden bg-[var(--skill-light)] dark:bg-[var(--light)] p-2'
        >
          <img
            class='object-fill'
