            src='https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/flask/flask-original.svg'
          />
        </i>
        <i
          class='aspect-1 rounded-lg overflow-hidden bg-[var(--skill-light)] dark:bg-[var(--light)] p-2'
        >
          <img
            class='object-fill'
            src='https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/express/express-original.svg'
          />
        </i>
        <i
          class='aspect-1 rounded-lg overflow-hidden bg-[var(--skill-light)] dark:bg-[var(--light)] p-2'
        >
          <img
            class='object-fill'
            src='https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mysql/mysql-original.svg'
          />
        </i>
        <i
          class='aspect-1 rounded-lg overflow-hidden bg-[var(--skill-light)] dark:bg-[var(--light)] p-2'
        >
          <img
            class='object-fill'
            src='https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg'
          />
        </i>
        <i
          class='aspect-1 rounded-lg overflow-hidden bg-[var(--skill-light)] dark:bg-[var(--light)] p-2'
        >
          <img
            class='object-fill'
            src='https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tensorflow/tensorflow-original.svg'
          />
        </i>
        <i class='aspect-1 rounded-lg overflow-hidden bg-[#d00000]'>
          <img
            class='object-fill'
            src='https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/keras/keras-original.svg'
          />
        </i>
      </div>
    </div>
  </section>

