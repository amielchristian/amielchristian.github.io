---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { ExternalLink, Github } from '@lucide/svelte';

import { render } from 'astro:content';
import { getAllImages } from '../../utils';

// get all paths
export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({
    params: { id: work.id },
    props: { work },
  }));
}

const { work } = Astro.props; // get work id from path
const { Content } = await render(work);
const repository: string | undefined = work.data.repository;
const liveDemo: string | undefined = work.data.liveDemo;
const images: string[] = getAllImages(work.id);
---

<Layout>
  <section class='sm:mx-[10%]'>
    <!-- <div>
      <h3 class="text-xl">Tech Stack</h3>
      <ul class="flex flex-wrap gap-2">
        {work.data.techStack.map((tech) => (
          <li class="bg-gray-200 dark:bg-gray-700 px-3 py-1 rounded-full text-sm">
            {tech}
          </li>
        ))}
    </div> -->
    <div>
      <div id='header' class='flex flex-row items-end justify-between mb-4'>
        <div>
          <h1 class='text-6xl font-bold'>{work.data.title}</h1>
          <div class='flex flex-row flex-wrap gap-x-2 gap-y-1 mt-2'>
            {
              work.data.techStack.map((tech) => (
                <div class='dark:bg-[var(--blue-2)] bg-[var(--blue-2-dark)] text-[var(--dark)] dark:text-[var(--light)] text-sm py-1 px-3 rounded-4xl'>
                  {tech}
                </div>
              ))
            }
          </div>
        </div>
        <div class='flex flex-col justify-end gap-1'>
          {
            repository && (
              <a
                class='bg-[var(--yellow-2)] p-2 rounded-4xl'
                aria-label='GitHub Repository'
                href={work.data.repository}
              >
                <Github color='var(--light)' size={20} />
              </a>
            )
          }
          {
            liveDemo && (
              <a
                class='bg-[var(--yellow-2)] p-2 rounded-4xl'
                aria-label='Live Website'
                href={work.data.liveDemo}
              >
                <ExternalLink color='var(--light)' size={20} />
              </a>
            )
          }
        </div>
      </div>
      <!-- <h3 class='italic'>{work.data.description}</h3> -->
      <hr />
      <div class='markdown my-8'>
        <Content />
      </div>
      <div>
        {
          images.map((image) => (
            <img src={image} class='rounded-2xl overflow-hidden' />
          ))
        }
      </div>
    </div>
  </section>

  <style is:global>
    .markdown a {
      color: #597072;
    }
    .dark .markdown a {
      color: #7e9ea0;
    }
    .markdown h1 {
      font-size: x-large;
    }
    .markdown p {
      margin: 1rem auto;
    }
  </style>
</Layout>
