---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/global/ProjectCard.svelte';
import { getCollection } from 'astro:content';
import { getMainImage } from '../../utils';

const works = await getCollection('works');
---

<Layout>
  <section class='mb-[5%]'>
    <h1 class='text-6xl font-bold text-center'>Works</h1>
    <div class='mt-12 grid grid-cols-1 lg:grid-cols-2 gap-3'>
      {
        works.map((work, index) => (
          <ProjectCard
            client:only='svelte'
            title={work.data.title}
            url={`/works/${work.id}`}
            image={getMainImage(work.id)}
            description={work.data.description}
            {index}
          />
        ))
      }
    </div>
    <div class='grid grid-cols-3'></div>
  </section>
</Layout>
