---
import Nav from '../components/Nav.svelte';
import SEO from '../components/SEO.svelte';
import '../styles/global.css';
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <SEO />
  </head>
  <body
    class='fixed bg-[var(--light)] dark:bg-[var(--dark)] dark:text-[var(--light)] px-[8%] w-full h-full overflow-x-hidden'
  >
    <Nav client:only='svelte' />
    <div class='font-mono h-[100%] py-[2%]'>
      <slot />
    </div>
  </body>
  <script>
    let theme = localStorage.getItem('theme') ?? 'light';
    if (theme === 'dark') document.documentElement.classList.toggle('dark');
  </script>
</html>
